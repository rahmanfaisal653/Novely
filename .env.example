# ===== Environment Variables untuk Novely =====
# Salin file ini menjadi .env.local untuk development, atau set langsung
# di environment produksi.

# GEMINI_API_KEY — OPSIONAL (hanya fallback).
# Dipakai ketika user BELUM mengisi Pengaturan AI di aplikasi
# (base URL + API key + model). User yang sudah mengisi Pengaturan AI
# memakai provider mereka sendiri dan variabel ini tidak diperlukan.
# Dapatkan key di https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# SCOPUS_API_KEY — OPSIONAL (default Scopus).
# Key Elsevier untuk referensi literatur. Bisa juga diisi per-user
# lewat Pengaturan AI (disimpan di localStorage).
# Dapatkan key di https://dev.elsevier.com
SCOPUS_API_KEY=""

# APP_URL — OPSIONAL. URL publik tempat aplikasi di-hosting.
APP_URL=""
